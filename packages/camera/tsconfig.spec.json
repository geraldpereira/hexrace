{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["vitest/globals", "node"],
    "noEmit": true,
    "paths": {
      "@camera/*": ["./src/*"],
      "@hexrace/commons": ["../commons/src/index.ts"],
      "@commons/*": ["../commons/src/*"],
      "@hexrace/engine": ["../engine/src/index.ts"],
      "@engine/*": ["../engine/src/*"]
    }
  },
  "include": ["src", "test-setup.ts", "vitest.config.ts"]
}
