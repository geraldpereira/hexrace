{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "vitest/globals",
      "node"
    ],
    "noEmit": true,
    "paths": {
      "@car/*": [
        "./src/*"
      ],
      "@hexrace/commons": [
        "../commons/src/index.ts"
      ],
      "@commons/*": [
        "../commons/src/*"
      ],
      "@hexrace/engine": [
        "../engine/src/index.ts"
      ],
      "@engine/*": [
        "../engine/src/*"
      ],
      "@hexrace/inputs": [
        "../inputs/src/index.ts"
      ],
      "@inputs/*": [
        "../inputs/src/*"
      ],
      "@hexrace/camera": [
        "../camera/src/index.ts"
      ],
      "@camera/*": [
        "../camera/src/*"
      ],
      "@hexrace/tile": [
        "../tile/src/index.ts"
      ],
      "@tile/*": [
        "../tile/src/*"
      ]
    }
  },
  "include": [
    "src",
    "test-setup.ts",
    "vitest.config.ts"
  ]
}
