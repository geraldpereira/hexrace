{
  "name": "hexrace",
  "version": "0.0.0",
  "private": true,
  "description": "Rally arcade sur tuiles hexagonales, dans le navigateur.",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:root",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint ${LINT_FILES:-.}",
    "lint:fix": "npm run lint -- --fix",
    "duplication": "jscpd",
    "unused": "knip",
    "format": "prettier --write 'packages/*/src/**/*.{ts,html,scss}' 'apps/*/src/**/*.{ts,html,scss}'",
    "typecheck:root": "tsc -p quality/tsconfig.json"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@eslint/js": "^9.39.1",
    "@types/estree": "^1.0.8",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.0.8",
    "angular-eslint": "^22.1.0",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^4.2.0",
    "jscpd": "^5.0.14",
    "jsdom": "^28.0.0",
    "knip": "^6.31.0",
    "prettier": "^3.8.3",
    "type-coverage": "^2.30.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.0.8"
  }
}
