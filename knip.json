{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "dependency-cruiser",
    "material-symbols",
    "type-coverage"
  ],
  "workspaces": {
    ".": {
      "entry": [],
      "project": [
        "quality/**/*.js"
      ]
    },
    "packages/inputs": {
      "entry": [
        "src/**/*.spec.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/web": {
      "entry": [
        "src/main.ts",
        "src/test-setup.ts",
        "src/**/*.spec.ts"
      ],
      "project": "src/**/*.ts"
    },
    "packages/hud": {
      "entry": [
        "src/**/*.spec.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/commons": {
      "entry": [
        "src/**/*.spec.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/engine": {
      "entry": [
        "src/**/*.spec.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  }
}
