hexrace-track 1

id: north-ring-01
name: Hexagone
environment: north  # Pays du Nord
mode: track

# Une ligne par tuile, dans l'ordre de parcours. L'entrée est toujours la face 6.
# exit face de sortie · pos/w position et largeur de la piste en sortie · sh bas-côtés gauche,droite
# h hauteur · t rangs piste/bas-côté/paysage · obs obstacles (voir trackFile.ts)

[tiles]
start  exit=10  pos=3  w=2  sh=1,1  h=24  t=2/2/2
       exit=10  pos=3  w=2  sh=1,1  h=32  t=2/2/2
       exit=10  pos=3  w=2  sh=1,1  h=32  t=2/2/2
       exit=10  pos=3  w=2  sh=1,1  h=24  t=2/2/2
       exit=10  pos=2  w=3  sh=1,1  h=24  t=2/2/2
       exit=10  pos=3  w=2  sh=1,1  h=24  t=2/2/2
