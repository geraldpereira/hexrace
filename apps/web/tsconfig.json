{
  "extends": "../../tsconfig.base.json",
  "compileOnSave": false,
  "compilerOptions": {
    "module": "preserve",
    "importHelpers": true,
    "noPropertyAccessFromIndexSignature": true,
    "declaration": false,
    "paths": {
      "@hexrace/commons": ["../../packages/commons/src/index.ts"],
      "@commons/*": ["../../packages/commons/src/*"],
      "@hexrace/engine": ["../../packages/engine/src/index.ts"],
      "@engine/*": ["../../packages/engine/src/*"],
      "@hexrace/camera": ["../../packages/camera/src/index.ts"],
      "@camera/*": ["../../packages/camera/src/*"],
      "@hexrace/tile": ["../../packages/tile/src/index.ts"],
      "@tile/*": ["../../packages/tile/src/*"],
      "@hexrace/track": ["../../packages/track/src/index.ts"],
      "@track/*": ["../../packages/track/src/*"],
      "@hexrace/car": ["../../packages/car/src/index.ts"],
      "@car/*": ["../../packages/car/src/*"],
      "@hexrace/game-commons": ["../../packages/game-commons/src/index.ts"],
      "@game-commons/*": ["../../packages/game-commons/src/*"],
      "@hexrace/inputs": ["../../packages/inputs/src/index.ts"],
      "@inputs/*": ["../../packages/inputs/src/*"],
      "@hexrace/hud": ["../../packages/hud/src/index.ts"],
      "@hud/*": ["../../packages/hud/src/*"],
      "@ui/*": ["./src/app/*"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.spec.json" }]
}
